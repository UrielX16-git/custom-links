API_TOKEN=replace_with_random_secret
BASE_URL=https://your-domain.example
DB_PATH=/data/links.db
DEFAULT_EXPIRES_IN=3600
MAX_EXPIRES_IN=2592000
MAX_SLUG_LEN=80
SHARED_PROXY_NETWORK=npm_default

# CORS (Frontend)
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# Limpieza automática de expirados
AUTO_CLEANUP_ENABLED=true
CLEANUP_INTERVAL_SECONDS=86400

# MCP bridge
MCP_API_BASE=http://custom-links:8000
MCP_API_TOKEN=replace_with_same_api_token
